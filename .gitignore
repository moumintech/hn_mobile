# ==============================================================
# .gitignore — HealthNorth Mobile
# Flutter / Dart / Android / iOS / PHP / MySQL / VS Code / Windows
# ==============================================================

# ---------------------------------------------------------------
# SECRETS & CREDENTIALS (NE JAMAIS PUBLIER)
# ---------------------------------------------------------------
# Fichiers de configuration avec identifiants réels
**/config/database.php
config.php
.env
.env.local
.env.*.local
.env.production
.env.staging

# Clés de signature Android (keystore)
*.jks
*.keystore
key.properties
android/key.properties

# Certificats et clés privées
*.pem
*.p12
*.pfx
*.key

# Google Services (contient des clés Firebase)
google-services.json
GoogleService-Info.plist

# ---------------------------------------------------------------
# FLUTTER / DART / PUB
# ---------------------------------------------------------------
.dart_tool/
.pub-cache/
.pub/
.packages
**/doc/api/

# Build artifacts
/build/
/coverage/

# Symbolication & obfuscation
app.*.symbols
app.*.map.json

# Flutter generated
.flutter-plugins
.flutter-plugins-dependencies
flutter_export_environment.sh
Generated.xcconfig
GeneratedPluginRegistrant.*
.metadata

# ---------------------------------------------------------------
# ANDROID
# ---------------------------------------------------------------
**/android/.gradle/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/

# Fichier local machine (contient les chemins SDK locaux)
android/local.properties

# Gradle caches
**/.gradle/
**/gradle/wrapper/gradle-wrapper.jar

# ---------------------------------------------------------------
# iOS / macOS
# ---------------------------------------------------------------
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/.last_build_id
**/ios/Flutter/ephemeral/
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/Generated.xcconfig
**/macos/Flutter/ephemeral/
**/macos/Flutter/GeneratedPluginRegistrant.swift

# ---------------------------------------------------------------
# PHP / MySQL / Apache / WAMP
# ---------------------------------------------------------------
# Credentials base de données
api/config/database.php
db_test.php
test_login_debug.php
tmp_*.php
debug_*.php
*_debug.php

# Fichiers de dump SQL sensibles
*.sql.bak
*.dump
*_backup.sql
*_sauvegarde.sql
hn_web*.sql

# Logs Apache / PHP
*.log
logs/
log/
error_log

# Sessions PHP
sessions/
sess_*

# Uploads utilisateurs (données personnelles patients)
uploads/
storage/
files/
documents/

# ---------------------------------------------------------------
# IDE — IntelliJ / Android Studio
# ---------------------------------------------------------------
*.iml
*.ipr
*.iws
.idea/
!.idea/runConfigurations/

# ---------------------------------------------------------------
# IDE — VS Code
# ---------------------------------------------------------------
.vscode/
!.vscode/extensions.json

# ---------------------------------------------------------------
# IDE — Xcode
# ---------------------------------------------------------------
xcuserdata/

# ---------------------------------------------------------------
# OS — Windows / macOS / Linux
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Crash dumps JVM
hs_err_pid*.log
replay_pid*.log

# ---------------------------------------------------------------
# DIVERS
# ---------------------------------------------------------------
*.swp
*.swo
*.tmp
*.cache
*~
.history
.svn/
.atom/
.buildlog/
migrate_working_dir/
